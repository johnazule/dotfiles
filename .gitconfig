[user]
	name = Jeremy Spedding
	email = jspedding@simonschools.net
[fetch]
	prune = true
[safe]
	directory = E:/Development Projects/simon
[pull]
	rebase = true
[mergetool "vimdiff"]
	layout = LOCAL,BASE,REMOTE/MERGED
[mergetool]
	tool = nvimdiff
[merge]
	tool = nvimdiff
	conflictStyle = zdiff3
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[diff]
	wsErrorHightlight = all
[delta]
	navigate = true
	line-numbers = true
	; minus-style = syntax normal
	; plus-style = syntax normal
	commit-style = raw
	whitespace-error-style = purple reverse
[push]
	autoSetupRemote = true
	default = upstream
